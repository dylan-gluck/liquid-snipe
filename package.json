{
  "name": "liquid-snipe",
  "version": "0.1.0",
  "description": "Solana trading bot that monitors for new liquidity pools and executes trades",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint:fix && bun run fmt",
    "monitor": "bun scripts/monitor-liquidity.ts",
    "capture": "bun scripts/capture-pools.ts",
    "enrich": "bun scripts/enrich-pools.ts",
    "snapshot": "bun scripts/snapshot-prices.ts",
    "signals": "bun scripts/signals.ts",
    "backtest": "bun scripts/backtest.ts",
    "demo": "bun scripts/demo.ts",
    "helius:signup": "bun scripts/helius-signup.ts",
    "helius:capture": "bun scripts/capture-helius.ts",
    "live:shadow": "bun scripts/run-live.ts --mode shadow",
    "live": "bun scripts/run-live.ts --mode live",
    "admin:halt": "bun scripts/admin/halt.ts halt",
    "admin:resume": "bun scripts/admin/halt.ts resume",
    "admin:fund-hot": "bun scripts/admin/fund-hot.ts"
  },
  "dependencies": {
    "@jup-ag/api": "^6.0.48",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@triton-one/yellowstone-grpc": "^5.0.8",
    "helius-sdk": "^2.2.2",
    "jito-ts": "^4.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1"
  }
}
