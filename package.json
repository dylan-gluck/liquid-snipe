{
  "name": "liquid-snipe",
  "version": "0.0.1",
  "description": "Solana trading bot that monitors for new liquidity pools and executes trades",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint:fix && bun run fmt",
    "monitor": "bun scripts/monitor-liquidity.ts",
    "capture": "bun scripts/capture-pools.ts",
    "enrich": "bun scripts/enrich-pools.ts",
    "snapshot": "bun scripts/snapshot-prices.ts",
    "signals": "bun scripts/signals.ts",
    "backtest": "bun scripts/backtest.ts",
    "demo": "bun scripts/demo.ts",
    "helius:signup": "bun scripts/helius-signup.ts",
    "helius:capture": "bun scripts/capture-helius.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "helius-sdk": "^2.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1"
  }
}
